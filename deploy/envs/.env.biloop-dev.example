# ============================================================
# biloop-dev — https://dev.accounting.biloop.ai   (branch: develop)
# Copied to /opt/accounting/biloop-dev/.env by remote-deploy.sh
# on first deploy; DJANGO_SECRET_KEY and the DATABASE_URL
# password are filled in from GitHub secrets at that point.
#
# DJANGO_SECRET_KEY must match the pharmacy biloop-dev key
# (shared auth/JWT), and DATABASE_URL is the pharmacy biloop-dev
# database — both apps read the same Postgres DB.
# ============================================================

# Django
DJANGO_ENV=development
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=dev.accounting.biloop.ai,localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=https://dev.accounting.biloop.ai

# Same database as the pharmacy app (host PostgreSQL)
DATABASE_URL=postgres://healthcare:PASSWORD@host.docker.internal:5432/healthcare_biloop_dev

# Stack
FRONTEND_PORT=3021
GUNICORN_WORKERS=2

# Inventory → journal sync cadence (seconds)
SYNC_INTERVAL=300
