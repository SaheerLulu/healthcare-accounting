# ============================================================
# Accounting PROD environment variables
# Copy to /opt/accounting/prod/.env and fill in values
# ============================================================

DJANGO_ENV=production
DJANGO_SECRET_KEY=CHANGE-ME-TO-A-RANDOM-STRING
DJANGO_ALLOWED_HOSTS=accounting.seefmed.com,localhost,127.0.0.1,207.180.215.167

# Use the SAME database as the inventory app
DATABASE_URL=postgres://healthcare:PASSWORD@host.docker.internal:5432/healthcare_prod

# CORS / CSRF
CORS_ALLOWED_ORIGINS=https://accounting.seefmed.com
CSRF_TRUSTED_ORIGINS=https://accounting.seefmed.com

# Frontend port (exposed to host)
PROD_FRONTEND_PORT=3004
