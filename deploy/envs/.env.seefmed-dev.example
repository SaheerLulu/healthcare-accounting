# ============================================================
# seefmed-dev — https://devaccounting.seefmed.com   (branch: dev-seefmed)
# Copied to /opt/accounting/seefmed-dev/.env by remote-deploy.sh
# on first deploy; DJANGO_SECRET_KEY and the DATABASE_URL
# password are filled in from GitHub secrets at that point.
#
# NOTE: this environment keeps the pre-split dev identity —
# port 3003 and the shared healthcare_dev database. The secret
# key is shared with pharmacy seefmed-dev (auth/JWT SSO).
# ============================================================

# Django
DJANGO_ENV=development
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=devaccounting.seefmed.com,localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=https://devaccounting.seefmed.com

# Same database as the pharmacy app (host PostgreSQL)
DATABASE_URL=postgres://healthcare:PASSWORD@host.docker.internal:5432/healthcare_dev

# Stack
FRONTEND_PORT=3003
GUNICORN_WORKERS=2

# Inventory → journal sync cadence (seconds)
SYNC_INTERVAL=300
