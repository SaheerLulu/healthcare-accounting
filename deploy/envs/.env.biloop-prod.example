# ============================================================
# biloop-prod — https://accounting.biloop.ai   (branch: main)
# Copied to /opt/accounting/biloop-prod/.env by remote-deploy.sh
# on first deploy; DJANGO_SECRET_KEY and the DATABASE_URL
# password are filled in from GitHub secrets at that point.
#
# DJANGO_SECRET_KEY must match the pharmacy biloop-prod key
# (shared auth/JWT), and DATABASE_URL is the pharmacy biloop-prod
# database — both apps read the same Postgres DB.
# ============================================================

# Django
DJANGO_ENV=production
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=accounting.biloop.ai,localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=https://accounting.biloop.ai

# Same database as the pharmacy app (host PostgreSQL)
DATABASE_URL=postgres://healthcare:PASSWORD@host.docker.internal:5432/healthcare_prod

# Stack
FRONTEND_PORT=3022
GUNICORN_WORKERS=3

# Inventory → journal sync cadence (seconds)
SYNC_INTERVAL=300
