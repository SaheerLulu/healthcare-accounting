# ============================================================
# Accounting DEV environment variables
# Copy to /opt/accounting/dev/.env and fill in values
# ============================================================

DJANGO_ENV=development
DJANGO_SECRET_KEY=change-me-to-a-random-string
DJANGO_ALLOWED_HOSTS=devaccounting.seefmed.com,localhost,127.0.0.1,207.180.215.167

# Use the SAME database as the inventory app
DATABASE_URL=postgres://healthcare:PASSWORD@host.docker.internal:5432/healthcare_dev

# Frontend port (exposed to host)
DEV_FRONTEND_PORT=3003
